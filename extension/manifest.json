{
  "manifest_version": 3,
  "name": "Agent Tabs",
  "version": "1.0.0",
  "description": "Lets local AI agents (via the agent-tabs MCP server) work in background tabs of this Chrome profile without taking focus.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Tabs",
    "default_popup": "popup.html"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "webNavigation",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
